# Regent configuration — copy to .env and fill in. Never commit .env.
# Every variable is read by regent/bootstrap.py (platform) or regent/api/app.py (API).

# --- Model provider ---------------------------------------------------------
# anthropic (default, needs ANTHROPIC_API_KEY) | local (needs REGENT_LOCAL_URL) | replay (fixtures, no network)
REGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Fixture file for the replay provider (tests, demos, CI without a key)
REGENT_REPLAY_FILE=
# OpenAI-compatible endpoint for a model that runs inside your network (vLLM, Ollama, TGI…).
# When set alongside the anthropic provider it receives content classified above the
# mandate's max_remote_class instead of the remote provider.
REGENT_LOCAL_URL=
REGENT_LOCAL_MODEL=
REGENT_LOCAL_KEY=

# --- Policy, prompts, skills ------------------------------------------------
REGENT_MANDATES_DIR=policies/mandates
# Optional overlays: organisation skills and prompt overrides
REGENT_SKILLS_DIR=
REGENT_PROMPTS_DIR=

# --- Audit ------------------------------------------------------------------
# Hash-chained JSON Lines ledger. Ship it to write-once storage in production.
REGENT_LEDGER=.regent/ledger.jsonl
# Checkout the agents work in (API server only; the CLI uses --workspace)
REGENT_WORKSPACE=.

# --- Integrations -----------------------------------------------------------
# GitHub: the Actions job token in CI, a GitHub App installation token elsewhere.
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook (HMAC SHA-256 of the body)
GITHUB_WEBHOOK_SECRET=
# Bearer token Alertmanager sends on /webhooks/alertmanager
ALERTMANAGER_WEBHOOK_TOKEN=
# Repository used for alerts that carry no `repository` label
REGENT_DEFAULT_REPOSITORY=
# Prometheus HTTP API used by the metrics.query tool
PROMETHEUS_URL=http://prometheus:9090

# --- Observability ----------------------------------------------------------
# OTLP/HTTP endpoint for traces (optional; no-op when unset or when the otel extra is missing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=regent
